# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot
POSTGRES_DB=stockpilot
POSTGRES_PORT=5432

# --- Application (stockpilot.core.config.Settings) ---
ENVIRONMENT=local
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# json or console (easier to read)
LOG_FORMAT=console
DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot
DATABASE_CONNECT_TIMEOUT=3

# --- Coverage and aging (days) ---
# Recent sales used to compute the daily sales pace
SALES_WINDOW_DAYS=60
# Less coverage than this is a shortage
LOW_COVERAGE_DAYS=15
# Longer than this in stock is an aged unit
AGED_AFTER_DAYS=90

# --- External APIs (no keys needed) ---
# Timeouts apply to each attempt
HTTP_CONNECT_TIMEOUT_SECONDS=2
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_ATTEMPTS=3
# After an API fails every attempt, fail fast for this long (0: always try)
HTTP_FAILURE_COOLDOWN_SECONDS=60
DOLAR_API_URL=https://dolarapi.com
EXCHANGE_RATE_TTL_SECONDS=600
ARGENTINA_DATOS_URL=https://api.argentinadatos.com
HOLIDAYS_TTL_SECONDS=86400
VPIC_URL=https://vpic.nhtsa.dot.gov/api/vehicles
VIN_TTL_SECONDS=86400
GEOREF_URL=https://apis.datos.gob.ar/georef/api/v1.0
