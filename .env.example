# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot
POSTGRES_DB=stockpilot
POSTGRES_PORT=5432

# --- Application (stockpilot.core.config.Settings) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://stockpilot:stockpilot@localhost:5432/stockpilot
DATABASE_CONNECT_TIMEOUT=3
